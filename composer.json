{
    "name": "ades4827/sprintflow",
    "description": "Laravel Package for speed up your project development",
    "homepage": "https://github.com/ades4827/sprintflow",
    "license": "GPL-2.0-or-later",
    "type": "library",
    "authors": [
        {
            "name": "Michele Lucchina",
            "email": "michele@lucchina.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "archtechx/enums": "^1.1",
        "brick/money": "^0.14.0",
        "laravel/framework": "^12.0|^13.0",
        "livewire/livewire": "^4.0",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-settings": "^3.4",
        "spatie/laravel-translatable": "^6.10",
        "yajra/laravel-datatables-oracle": "^12.0|^13.0"
    },
    "suggest": {
        "carlos-meneses/laravel-mpdf": "Required by ToPdfTrait (PDF generation)",
        "fakerphp/faker": "Required by the cache:test command",
        "laravel/sanctum": "Required by Models\\User (HasApiTokens)",
        "livewire/flux": "Enables the sprintflow_fluxui views, ValidFluxIcon rule and flux components",
        "maatwebsite/excel": "Required by ExcelHelper (brings phpoffice/phpspreadsheet)",
        "mattiverse/laravel-userstamps": "Required by MultiguardUserstamps",
        "propaganistas/laravel-phone": "Required by LivewirePhonesTrait (phone parsing/validation)",
        "rappasoft/laravel-authentication-log": "Required by Models\\User (AuthenticationLoggable)",
        "spatie/laravel-medialibrary": "Required by media routes, FileAccessController, LivewireMediaTrait and CustomUrlGenerator",
        "wildside/userstamps": "Required by Models\\User (Userstamps)",
        "wireui/wireui": "Enables the sprintflow_wireui views and components"
    },
    "autoload": {
        "psr-4": {
            "Ades4827\\Sprintflow\\": "src"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ades4827\\Sprintflow\\SprintflowServiceProvider"
            ],
            "aliases": {
                "Sprintflow": "Ades4827\\Sprintflow\\SprintflowFacade"
            }
        }
    }
}
